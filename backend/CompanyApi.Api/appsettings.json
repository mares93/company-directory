{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "AuthPerMinute": 10
  },
  "Relevance": {
    "InspectContent": false
  },
  "Jwt": {
    "Key": "dev-only-secret-key-change-me-0123456789abcdef",
    "Issuer": "CompanyApi",
    "Audience": "CompanyApi.Client",
    "ExpiresMinutes": 60
  }
}
